# What belongs in the source distribution beyond the package itself.
# Kept deliberately small: docs, tests and the Cloudflare port are useful to a
# reader of the sdist but must not be installed as package data.
include README.md
include README_CN.md
include LICENSE
include requirements.txt
include config.example.json
include start.bat

# The shipped documentation tells the reader to use these, so an sdist without
# them is a distribution that contradicts its own docs:
#   - README.md documents `python gemini_web2api.py` as a supported entry point
#   - README.md embeds <img src="logo.png">, and pyproject's `readme` makes that
#     README the rendered package front page
#   - docs/DEPLOYMENT.md walks through the Dockerfile and both compose files
# The Dockerfile and .dockerignore are deliberately paired: shipping one without
# the other would let a reader build an image that bakes in their secrets.
include gemini_web2api.py
include logo.png
include Dockerfile
include .dockerignore
include docker-compose.yml
include docker-compose.local.yml

recursive-include scripts *.py
recursive-include docs *.md
recursive-include tests *.py
# dashboard_render_assertions.js is read at runtime by DashboardScriptTests,
# so an sdist without it would fail on a machine that has Node.
recursive-include tests *.js
recursive-include cloudflare *.js *.MD *.md
recursive-include gemini-cookie-sync-extension *.js *.json *.md *.html

# Local secrets must never end up in a distribution.
exclude config.json
exclude cookie.txt
exclude cookie.json
exclude gemini-auth.json
exclude .env
global-exclude __pycache__
global-exclude *.py[cod]
